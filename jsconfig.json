{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "checkJs": false,
    "useUnknownInCatchVariables": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["plugin/src/**/*.js", "Config/Scripts/Templater/**/*.js"]
}

filters:
  and:
    - file.tags.contains("invoice")
views:
  - type: table
    name: Invoices
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - client
      - project
      - invoice_date
      - period_start
      - period_end
      - hours
      - total
      - sent
      - paid
    sort:
      - property: file.name
        direction: DESC

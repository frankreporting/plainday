{
  "data_version": 2,
  "command_timeout": 5,
  "templates_folder": "Config/Templates",
  "templates_pairs": [],
  "trigger_on_file_creation_mode": "regex",
  "auto_jump_to_cursor": true,
  "jump_to_cursor_after_file_name": false,
  "shell_path": "",
  "user_scripts_folder": "Config/Scripts/Templater",
  "folder_templates": [
    {
      "folder": "Inbox",
      "template": "Config/Templates/Get Template.md"
    },
    {
      "folder": "/",
      "template": "Config/Templates/Get Template.md"
    }
  ],
  "file_templates": [
    {
      "regex": ".*",
      "template": "Config/Templates/Get Template.md"
    }
  ],
  "syntax_highlighting": true,
  "syntax_highlighting_mobile": false,
  "enabled_templates_hotkeys": [],
  "startup_templates": [],
  "intellisense_render": "1",
  "ignore_folders_on_creation": [],
  "enable_ribbon_icon": true,
  "locale": "en"
}
views:
  - type: table
    name: Active
    filters:
      and:
        - file.tags.contains("project")
        - or:
            - '!status.containsAny("Canceled", "Done", "On Hold")'
            - status.isEmpty()
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - start
      - due
      - status
    sort:
      - property: end
        direction: ASC
  - type: table
    name: Inactive
    filters:
      and:
        - file.tags.containsAny("project")
        - '!status.containsAny("In Progress", "To Do")'
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
    sort:
      - property: file.name
        direction: ASC
    hideEmptyGroups: false
    columnSize:
      file.name: 307
